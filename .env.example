# Server configuration
PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# Telegram bot token (from @BotFather)
# Leave empty or set to mock_token to run in local studio demo mode
TELEGRAM_BOT_TOKEN=mock_token

# Telegram Mini App URL (optional for production webapp button)
TELEGRAM_WEBAPP_URL=http://localhost:8080

# Demo mode: allows instant UI testing without bot credentials
DEMO_MODE=true

# Storage settings
STORAGE_DIR=./storage/temp
MAX_FILE_AGE_MINUTES=60
MAX_UPLOAD_SIZE_MB=100
